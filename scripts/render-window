#!/bin/sh
set -u

empty() {
	printf '\n'
	exit 0
}

[ "$#" -eq 3 ] || empty
session=$1
window=$2
active_pane=$3
printf '%s\n' "$session" | grep -Eq '^\$[0-9]+$' || empty
printf '%s\n' "$window" | grep -Eq '^@[0-9]+$' || empty
printf '%s\n' "$active_pane" | grep -Eq '^%[0-9]+$' || empty

root=$(CDPATH= cd "$(dirname "$0")" && pwd -P) || empty
# shellcheck source=state.sh
. "$root/state.sh" || empty
tas_load_options || empty
panes=$(tmux list-panes -t "$session:$window" -F '#{pane_index}|#{pane_id}') || empty

printf '%s\n' "$panes" | sort -t '|' -k1,1n -k2,2 | while IFS='|' read -r _index pane; do
	tas_read_state "$pane" || continue
	[ -n "$_tas_glyph" ] || continue
	tas_present_glyph "$_tas_glyph" "$_tas_style" "$tas_unread" || continue
done | {
	IFS= read -r output || :
	[ -z "${output-}" ] || printf ' %s' "$output"
	printf '\n'
}
