# Core configuration ownership is sourced by the public loader.

# These declarations are shared by every managed acknowledgement hook and by
# the distinct pane-exit cleanup hook.
tas_core_configuration_acknowledge_command='run-shell "#{q:@tmux-agents-status-root}/scripts/acknowledge #{q:pane_id}"'
tas_core_configuration_cleanup_command='run-shell "#{q:@tmux-agents-status-root}/scripts/cleanup-pane #{q:hook_pane}"'
tas_core_configuration_newline='
'

tas_core_configuration_enumerate_discovery() {
	tas_core_configuration_callback=$1
	"$tas_core_configuration_callback" @tmux-agents-status-root "$tas_core_configuration_root" || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-protocol 2
}

tas_core_configuration_enumerate_defaults() {
	tas_core_configuration_callback=$1
	"$tas_core_configuration_callback" @tmux-agents-status-window '#(#{q:@tmux-agents-status-root}/scripts/render-window #{q:session_id} #{q:window_id} #{q:pane_id})' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-other-sessions '#(#{q:@tmux-agents-status-root}/scripts/render-other-sessions #{q:session_id})' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-running-glyph '•' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-running-style 'fg=cyan' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-waiting-glyph '?' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-waiting-style 'fg=yellow' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-completed-glyph '✓' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-completed-style 'fg=green' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-failed-glyph '!' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-failed-style 'fg=red' || return 1
	"$tas_core_configuration_callback" @tmux-agents-status-unread-style 'reverse,bold'
}

tas_core_configuration_enumerate_hooks() {
	tas_core_configuration_callback=$1
	"$tas_core_configuration_callback" window-pane-changed "$tas_core_configuration_acknowledge_command" || return 1
	"$tas_core_configuration_callback" session-window-changed "$tas_core_configuration_acknowledge_command" || return 1
	"$tas_core_configuration_callback" client-session-changed "$tas_core_configuration_acknowledge_command" || return 1
	"$tas_core_configuration_callback" client-attached "$tas_core_configuration_acknowledge_command" || return 1
	"$tas_core_configuration_callback" pane-exited "$tas_core_configuration_cleanup_command"
}

tas_core_configuration_install_discovery_entry() {
	tmux set-option -g "$1" "$2" || return 1
}

tas_core_configuration_global_option_exists() {
	tas_core_configuration_options=$(tmux show-options -g 2>/dev/null && printf x) || return 2
	tas_core_configuration_options=${tas_core_configuration_options%x}
	if printf '%s\n' "$tas_core_configuration_options" | awk -v option="$1" '
		$1 == option { found = 1 }
		END { exit !found }
	' >/dev/null 2>&1; then
		return 0
	else
		tas_core_configuration_status=$?
	fi
	[ "$tas_core_configuration_status" -eq 1 ] && return 1
	return 2
}

tas_core_configuration_default_marker() {
	printf '@tmux-agents-status-default-%s\n' "${1#@tmux-agents-status-}"
}

tas_core_configuration_install_default_entry() {
	tas_core_configuration_option=$1
	tas_core_configuration_default=$2
	tas_core_configuration_marker=$(tas_core_configuration_default_marker "$tas_core_configuration_option") || return 1
	if tmux set-option -go "$tas_core_configuration_option" "$tas_core_configuration_default" >/dev/null 2>/dev/null; then
		tmux set-option -s "$tas_core_configuration_marker" 1 >/dev/null 2>&1 || return 1
		return 0
	fi
	if tas_core_configuration_global_option_exists "$tas_core_configuration_option"; then
		tas_core_configuration_status=0
	else
		tas_core_configuration_status=$?
	fi
	[ "$tas_core_configuration_status" -eq 0 ] || return 1
}

tas_core_configuration_install_defaults() {
	tas_core_configuration_enumerate_defaults tas_core_configuration_install_default_entry
}

tas_core_configuration_hook_marker() {
	printf '@tmux-agents-status-hook-%s\n' "$1"
}

tas_core_configuration_selector_is_numeric() {
	tas_core_configuration_selector=$1
	tas_core_configuration_hook=$2
	case "$tas_core_configuration_selector" in
	"$tas_core_configuration_hook"[[]*[!0-9]*[]]) return 1 ;;
	"$tas_core_configuration_hook"[[]*[]])
		tas_core_configuration_number=${tas_core_configuration_selector#"$tas_core_configuration_hook["}
		tas_core_configuration_number=${tas_core_configuration_number%"]"}
		[ -n "$tas_core_configuration_number" ] || return 1
		case $tas_core_configuration_number in *[!0-9]*) return 1 ;; esac
		return 0
		;;
	esac
	return 1
}

tas_core_configuration_hook_matches() {
	tas_core_configuration_hook=$1
	tas_core_configuration_selector=$2
	tas_core_configuration_command=$3
	tas_core_configuration_selector_is_numeric "$tas_core_configuration_selector" "$tas_core_configuration_hook" || return 1
	tas_core_configuration_hooks=$(tmux show-hooks -g "$tas_core_configuration_hook" 2>/dev/null && printf x) || return 2
	tas_core_configuration_hooks=${tas_core_configuration_hooks%x}
	if printf '%s\n' "$tas_core_configuration_hooks" | awk -v selector="$tas_core_configuration_selector" -v command="$tas_core_configuration_command" '
		$1 == selector {
			sub(/^[^[:space:]]+[[:space:]]+/, "")
			if ($0 == command) found = 1
		}
		END { exit !found }
	' >/dev/null 2>&1; then
		return 0
	else
		tas_core_configuration_status=$?
	fi
	[ "$tas_core_configuration_status" -eq 1 ] && return 1
	return 2
}

tas_core_configuration_find_hook_selector() {
	tas_core_configuration_hook=$1
	tas_core_configuration_command=$2
	tas_core_configuration_hooks=$(tmux show-hooks -g "$tas_core_configuration_hook" 2>/dev/null && printf x) || return 2
	tas_core_configuration_hooks=${tas_core_configuration_hooks%x}
	tas_core_configuration_selector=$(printf '%s\n' "$tas_core_configuration_hooks" | awk -v hook="$tas_core_configuration_hook" -v command="$tas_core_configuration_command" '
		$1 ~ ("^" hook "\\[[0-9]+\\]$") {
			candidate = $1
			sub(/^[^[:space:]]+[[:space:]]+/, "")
			if ($0 == command) {
				number = candidate
				sub("^" hook "\\[", "", number)
				sub("\\]$", "", number)
				number += 0
				if (!found || number > maximum) {
					found = 1
					maximum = number
					selector = candidate
				}
			}
		}
		END { if (found) print selector }
	') || return 2
	[ -n "$tas_core_configuration_selector" ]
}

tas_core_configuration_read_server_option() {
	tas_core_configuration_option=$1
	if tas_core_configuration_option_value=$(tmux show-option -sqv "$tas_core_configuration_option" 2>/dev/null && printf x); then
		tas_core_configuration_option_value=${tas_core_configuration_option_value%x}
		tas_core_configuration_option_value=${tas_core_configuration_option_value%"$tas_core_configuration_newline"}
		return 0
	fi
	tas_core_configuration_options=$(tmux show-options -s 2>/dev/null && printf x) || return 2
	tas_core_configuration_options=${tas_core_configuration_options%x}
	if printf '%s\n' "$tas_core_configuration_options" | awk -v option="$tas_core_configuration_option" '
		$1 == option { found = 1 }
		END { exit !found }
	' >/dev/null 2>&1; then
		return 2
	else
		tas_core_configuration_status=$?
	fi
	[ "$tas_core_configuration_status" -eq 1 ] || return 2
	tas_core_configuration_option_value=
	return 1
}

tas_core_configuration_install_hook_entry() {
	tas_core_configuration_hook=$1
	tas_core_configuration_command=$2
	tas_core_configuration_marker=$(tas_core_configuration_hook_marker "$tas_core_configuration_hook") || return 1
	if tas_core_configuration_read_server_option "$tas_core_configuration_marker"; then
		tas_core_configuration_status=0
	else
		tas_core_configuration_status=$?
	fi
	case $tas_core_configuration_status in
	0) tas_core_configuration_recorded_selector=$tas_core_configuration_option_value ;;
	1) tas_core_configuration_recorded_selector= ;;
	*) return 1 ;;
	esac
	if [ "$tas_core_configuration_recorded_selector" = 1 ]; then
		if tas_core_configuration_find_hook_selector "$tas_core_configuration_hook" "$tas_core_configuration_command"; then
			tmux set-option -s "$tas_core_configuration_marker" "$tas_core_configuration_selector" >/dev/null 2>&1 || return 1
			return 0
		else
			tas_core_configuration_status=$?
		fi
		[ "$tas_core_configuration_status" -eq 1 ] || return 1
		tas_core_configuration_recorded_selector=
	fi
	if [ -n "$tas_core_configuration_recorded_selector" ]; then
		if tas_core_configuration_hook_matches "$tas_core_configuration_hook" "$tas_core_configuration_recorded_selector" "$tas_core_configuration_command"; then
			tas_core_configuration_status=0
		else
			tas_core_configuration_status=$?
		fi
		case $tas_core_configuration_status in
		0) return 0 ;;
		1) ;;
		*) return 1 ;;
		esac
	fi
	tmux set-option -su "$tas_core_configuration_marker" >/dev/null 2>&1 || :
	tmux set-hook -ag "$tas_core_configuration_hook" "$tas_core_configuration_command" >/dev/null 2>&1 || return 1
	if tas_core_configuration_find_hook_selector "$tas_core_configuration_hook" "$tas_core_configuration_command"; then
		tmux set-option -s "$tas_core_configuration_marker" "$tas_core_configuration_selector" >/dev/null 2>&1 || return 1
	else
		tmux set-option -s "$tas_core_configuration_marker" 1 >/dev/null 2>&1 || return 1
	fi
}

tas_core_configuration_install_hooks() {
	tas_core_configuration_enumerate_hooks tas_core_configuration_install_hook_entry
}

tas_install_core_configuration() {
	[ "$#" -eq 1 ] || return 64
	[ -n "$1" ] || return 64
	tas_core_configuration_root=$1
	tas_core_configuration_enumerate_discovery tas_core_configuration_install_discovery_entry || return 1
	tas_core_configuration_install_hooks || return 1
	tas_core_configuration_install_defaults
}
