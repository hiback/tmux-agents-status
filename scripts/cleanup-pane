#!/bin/sh
set -u

diagnose() {
	printf 'tmux-agents-status: cleanup-pane: %s failed\n' "$1" >&2
}

[ "$#" -eq 1 ] || exit 0
pane=$1
case $pane in %[0-9]*) case ${pane#%} in *[!0-9]*) exit 0 ;; esac ;; *) exit 0 ;; esac

tmux set-option -su "@tmux-agents-status-state-$pane" \; \
	set-option -su "@tmux-agents-status-ack-$pane" >/dev/null 2>&1 || {
	diagnose write
	exit 0
}
clients=$(tmux list-clients -F '#{client_name}' 2>/dev/null) || {
	diagnose query
	exit 0
}
printf '%s\n' "$clients" | while IFS= read -r client; do
	[ -n "$client" ] || continue
	tmux refresh-client -S -t "$client" >/dev/null 2>&1 || diagnose refresh
done
