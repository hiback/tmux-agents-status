#!/bin/sh
set -u

empty() {
	[ "$#" -eq 0 ] || printf 'tmux-agents-status: render-other-sessions: %s\n' "$1" >&2
	printf '\n'
	exit 0
}

[ "$#" -eq 1 ] || empty
current_session=$1
case $current_session in \$[0-9]*) case ${current_session#\$} in *[!0-9]*) empty ;; esac ;; *) empty ;; esac

root=$(CDPATH= cd "$(dirname "$0" 2>/dev/null)" && pwd -P) || empty 'render failed'
# shellcheck source=state.sh
. "$root/state.sh" || empty 'render failed'
tas_load_options || empty 'required query failed'

topology=$(tmux list-panes -a -F '#{session_id}|#{window_index}|#{pane_index}|#{pane_id}' 2>/dev/null && printf x) || empty 'required query failed'
topology=${topology%x}
case $topology in
'') ;;
*"$tas_newline") topology=${topology%"$tas_newline"} ;;
*) empty 'required query failed' ;;
esac
if [ -n "$topology" ]; then
	topology=$(printf '%s\n' "$topology" | awk -F '|' '
		NF != 4 || $1 !~ /^\$[0-9]+$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ || $4 !~ /^%[0-9]+$/ { exit 1 }
		{ print }
	' 2>/dev/null) || empty 'required query failed'
	attributed=$(printf '%s\n' "$topology" | awk -F '|' -v current="$current_session" '
		{
			pane = $4
			if ($1 == current) {
				in_current[pane] = 1
				next
			}
			session = substr($1, 2) + 0
			window = $2 + 0
			pane_index = $3 + 0
			if (!(pane in chosen_session) || session < chosen_session[pane] ||
			    (session == chosen_session[pane] && window < chosen_window[pane]) ||
			    (session == chosen_session[pane] && window == chosen_window[pane] && pane_index < chosen_index[pane])) {
				chosen_session[pane] = session
				chosen_window[pane] = window
				chosen_index[pane] = pane_index
			}
		}
		END {
			for (pane in chosen_session)
				if (!(pane in in_current))
					print chosen_session[pane] "|" chosen_window[pane] "|" chosen_index[pane] "|" pane
		}
	' 2>/dev/null) || empty 'render failed'
else
	attributed=
fi
attributed=$(printf '%s\n' "$attributed" | sort -t '|' -k1,1n -k2,2n -k3,3n -k4.2,4n 2>/dev/null) || empty 'render failed'

running=0
groups=
group_session=
group_alerts=

append_group() {
	[ -n "$group_alerts" ] || return 0
	session_id=\$$group_session
	session_query=$(tmux display-message -p -t "$session_id" '#{session_id}|#{session_name}' 2>/dev/null && printf x) || empty 'required query failed'
	session_query=${session_query%x}
	case $session_query in
	*"$tas_newline") session_query=${session_query%"$tas_newline"} ;;
	*) empty 'required query failed' ;;
	esac
	case $session_query in
	*'
'*) empty 'required query failed' ;;
	"$session_id|"*) session_name=${session_query#*|} ;;
	*) empty 'required query failed' ;;
	esac
	[ -n "$session_name" ] || empty 'required query failed'
	escaped_name=$(printf '%s' "$session_name" | sed 's/#/##/g' 2>/dev/null) || empty 'render failed'
	groups=${groups}${groups:+ }${escaped_name}:${group_alerts}
}

while IFS='|' read -r pane_session _window _index pane; do
	[ -n "$pane_session" ] || continue
	if [ -n "$group_session" ] && [ "$pane_session" != "$group_session" ]; then
		append_group
		group_alerts=
	fi
	group_session=$pane_session

	if ! tas_read_state "$pane"; then
		[ "$tas_error" != query ] || empty 'required query failed'
		continue
	fi
	case $tas_state in
		running) running=$((running + 1)) ;;
		*)
			[ "$tas_unread" = true ] && [ -n "$_tas_glyph" ] || continue
			alert=$(tas_present_glyph "$_tas_glyph" "$_tas_style" true) || empty 'render failed'
			group_alerts=$group_alerts$alert
			;;
	esac
done <<EOF
$attributed
EOF
append_group

body=
if [ "$running" -gt 0 ] && [ -n "$tas_running_glyph" ]; then
	running_glyph=$(tas_present_glyph "$tas_running_glyph" "$tas_running_style" false) || empty 'render failed'
	body=$running_glyph$running
fi
if [ -n "$groups" ]; then
	body=${body}${body:+ }$groups
fi
if [ -n "$body" ]; then
	printf '#[default]%s \n' "$body"
else
	printf '\n'
fi
