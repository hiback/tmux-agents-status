#!/bin/sh
set -u

diagnose() {
	printf 'tmux-agents-status: acknowledge: %s failed\n' "$1" >&2
}

[ "$#" -eq 1 ] || exit 0
pane=$1
case $pane in %[0-9]*) case ${pane#%} in *[!0-9]*) exit 0 ;; esac ;; *) exit 0 ;; esac

visible=$(tmux list-clients -F '#{pane_id}' 2>/dev/null) || {
	diagnose query
	exit 0
}
found=false
if [ -n "$visible" ]; then
	while IFS= read -r visible_pane; do
		case $visible_pane in
		%[0-9]*) case ${visible_pane#%} in *[!0-9]*) diagnose query; exit 0 ;; esac ;;
		*) diagnose query; exit 0 ;;
		esac
		[ "$visible_pane" != "$pane" ] || found=true
	done <<EOF
$visible
EOF
fi
[ "$found" = true ] || exit 0

root=$(CDPATH= cd "$(dirname "$0" 2>/dev/null)" && pwd -P) || {
	diagnose load
	exit 0
}
# shellcheck source=state.sh
. "$root/state.sh" || {
	diagnose load
	exit 0
}
tas_load_schema
if ! tas_read_state "$pane"; then
	[ "$tas_error" != query ] || diagnose query
	exit 0
fi
[ "$tas_state" != running ] && [ "$tas_unread" = true ] || exit 0

tmux set-option -s "@tmux-agents-status-ack-$pane" "$tas_generation" >/dev/null 2>&1 || {
	diagnose write
	exit 0
}
clients=$(tmux list-clients -F '#{client_name}' 2>/dev/null) || {
	diagnose query
	exit 0
}
printf '%s\n' "$clients" | while IFS= read -r client; do
	[ -n "$client" ] || continue
	tmux refresh-client -S -t "$client" >/dev/null 2>&1 || diagnose refresh
done
