#!/bin/sh
set -u

diagnose() {
	printf 'tmux-agents-status: cleanup-stale: %s failed\n' "$1" >&2
}

newline='
'
panes=$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null && printf x) || {
	diagnose query
	exit 0
}
panes=${panes%x}
case $panes in
'') ;;
*"$newline") panes=${panes%"$newline"} ;;
*) diagnose parse; exit 0 ;;
esac
if [ -n "$panes" ]; then
	panes=$(printf '%s\n' "$panes" | awk '
		$0 !~ /^%[0-9]+$/ { exit 1 }
		{ print }
	' 2>/dev/null) || {
		diagnose parse
		exit 0
	}
fi
options=$(tmux show-options -s 2>/dev/null && printf x) || {
	diagnose query
	exit 0
}
options=${options%x}
case $options in
'') ;;
*"$newline") options=${options%"$newline"} ;;
*) diagnose parse; exit 0 ;;
esac
option_names=$(printf '%s\n' "$options" | awk '
	/^@tmux-agents-status-(state|ack)-/ {
		if ($0 !~ /^@tmux-agents-status-(state|ack)-%[0-9]+[[:space:]]/) exit 1
		if ($1 !~ /^@tmux-agents-status-(state|ack)-%[0-9]+$/) exit 1
		print $1
	}
' 2>/dev/null) || {
	diagnose parse
	exit 0
}
removed=' '
changed=false
while IFS= read -r option; do
	case $option in
	@tmux-agents-status-state-*) pane=${option#@tmux-agents-status-state-} ;;
	@tmux-agents-status-ack-*) pane=${option#@tmux-agents-status-ack-} ;;
	*) continue ;;
	esac
	case $pane in %[0-9]*) case ${pane#%} in *[!0-9]*) continue ;; esac ;; *) continue ;; esac
	pane_exists=false
	if [ -n "$panes" ]; then
		while IFS= read -r live_pane; do
			[ "$live_pane" != "$pane" ] || pane_exists=true
		done <<EOF
$panes
EOF
	fi
	[ "$pane_exists" = false ] || continue
	case $removed in
	*" $pane "*) continue ;;
	esac
	removed="$removed$pane "
	if tmux set-option -su "@tmux-agents-status-state-$pane" \; \
		set-option -su "@tmux-agents-status-ack-$pane" >/dev/null 2>&1; then
		changed=true
	else
		diagnose write
	fi
done <<EOF
$option_names
EOF
[ "$changed" = true ] || exit 0
clients=$(tmux list-clients -F '#{client_name}' 2>/dev/null) || {
	diagnose query
	exit 0
}
printf '%s\n' "$clients" | while IFS= read -r client; do
	[ -n "$client" ] || continue
	tmux refresh-client -S -t "$client" >/dev/null 2>&1 || diagnose refresh
done
