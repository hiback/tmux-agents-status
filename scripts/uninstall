#!/bin/sh
set -u

failed=false
changed=false
diagnosed_query=false
diagnosed_parse=false
diagnosed_write=false
diagnosed_load=false

diagnose() {
	failed=true
	case $1 in
	query)
		[ "$diagnosed_query" = false ] || return
		diagnosed_query=true
		;;
	parse)
		[ "$diagnosed_parse" = false ] || return
		diagnosed_parse=true
		;;
	write)
		[ "$diagnosed_write" = false ] || return
		diagnosed_write=true
		;;
	load)
		[ "$diagnosed_load" = false ] || return
		diagnosed_load=true
		;;
	esac
	printf 'tmux-agents-status: uninstall: %s failed\n' "$1" >&2
}

has_option() {
	scope=$1
	name=$2
	tas_uninstall_options=$(tmux show-options "$scope" 2>/dev/null) || return 1
	printf '%s\n' "$tas_uninstall_options" | awk -v name="$name" '
		$1 == name { found = 1 }
		END { exit !found }
	' >/dev/null 2>&1
}

has_server_option() {
	has_option -s "$1"
}

remove_server_option() {
	option=$1
	if has_server_option "$option"; then
		if tmux set-option -su "$option" >/dev/null 2>&1; then
			changed=true
		else
			diagnose write
		fi
	fi
}

root=$(CDPATH= cd "$(dirname "$0" 2>/dev/null)" && pwd -P) || root=
configuration_loaded=false
if [ -n "$root" ] && [ -r "$root/core-configuration" ] &&
	sh -n "$root/core-configuration" >/dev/null 2>&1 &&
	. "$root/core-configuration" >/dev/null 2>&1 &&
	command -v tas_remove_core_configuration >/dev/null 2>&1; then
	configuration_loaded=true
else
	diagnose load
fi
if [ "$configuration_loaded" = true ]; then
	tas_core_configuration_remove_status=0
	tas_remove_core_configuration || tas_core_configuration_remove_status=$?
	[ "$tas_core_configuration_remove_status" -eq 64 ] && diagnose load
	[ "$tas_core_configuration_query_failed" = true ] && diagnose query
	[ "$tas_core_configuration_write_failed" = true ] && diagnose write
	[ "$tas_core_configuration_changed" = true ] && changed=true
fi

options=$(tmux show-options -s 2>/dev/null && printf x) || {
	diagnose query
	options=x
}
options=${options%x}
record_options=$(printf '%s\n' "$options" | awk '
	$1 ~ /^@tmux-agents-status-(state|ack)-%[0-9]+$/ { print $1 }
' 2>/dev/null) || {
	diagnose parse
	record_options=
}
while IFS= read -r option; do
	[ -n "$option" ] || continue
	remove_server_option "$option"
done <<EOF
$record_options
EOF

if [ "$changed" = true ]; then
	if [ -n "$root" ]; then
		"$root/refresh-clients" uninstall
	else
		diagnose load
	fi
fi

printf '%s\n' \
	'tmux-agents-status: remove these exact strings from tmux configuration:' \
	"set -g @plugin 'hiback/tmux-agents-status'" \
	'run-shell ~/.tmux/plugins/tmux-agents-status/tmux-agents-status.tmux' \
	'#{E:@tmux-agents-status-window}' \
	'#{E:@tmux-agents-status-other-sessions}'

[ "$failed" = false ]
