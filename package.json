{
  "name": "tmux-agents-status-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "./test/acceptance.sh && ./test/package-pi.sh && ./test/package-opencode.sh && ./test/package-claude.sh && ./test/package-codex.sh && node ./test/release-policy.mjs && node ./test/marketplace-verification.mjs && node ./test/workflow-contract.mjs",
    "test:release-policy": "node ./test/release-policy.mjs",
    "test:marketplace-verification": "node ./test/marketplace-verification.mjs",
    "test:workflow-contract": "node ./test/workflow-contract.mjs",
    "test:core": "./test/state-core.sh",
    "test:core-release": "./test/core-release.sh",
    "test:pi": "node ./test/pi-adapter.mjs && node ./test/lifecycle.mjs",
    "test:opencode": "node ./test/opencode-adapter.mjs && node ./test/opencode-lifecycle.mjs",
    "test:claude": "node ./test/claude-adapter.mjs && node ./test/claude-lifecycle.mjs",
    "test:codex": "node ./test/codex-adapter.mjs && node ./test/codex-lifecycle.mjs",
    "test:package": "./test/package-pi.sh && ./test/package-opencode.sh && ./test/package-claude.sh && ./test/package-codex.sh"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
