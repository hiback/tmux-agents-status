{
  "name": "tmux-agents-status-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "./test/acceptance.sh && ./test/package-pi.sh && ./test/package-opencode.sh && ./test/package-claude.sh && ./test/package-codex.sh",
    "test:core": "./test/state-core.sh",
    "test:pi": "node ./test/pi-adapter.mjs && node ./test/lifecycle.mjs",
    "test:opencode": "node ./test/opencode-adapter.mjs && node ./test/opencode-lifecycle.mjs",
    "test:claude": "node ./test/claude-adapter.mjs && node ./test/claude-lifecycle.mjs",
    "test:codex": "node ./test/codex-adapter.mjs && node ./test/codex-lifecycle.mjs",
    "test:package": "./test/package-pi.sh && ./test/package-opencode.sh && ./test/package-claude.sh && ./test/package-codex.sh"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
